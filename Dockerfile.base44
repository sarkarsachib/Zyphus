# Development runtime for the Zyphus CLI engine.
# Source is bind-mounted at /app by docker-compose.base44.yml, so this image
# only carries the interpreters and the pinned dependencies.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Node.js powers the engine's JavaScript module bridge (src/js_module_bridge_fixed.py).
# node powers the engine's JavaScript module bridge and the agent's js_module tool.
# espeak-ng is the agent's voice: the `speak` tool renders text to a wav (no audio
# device needed) and the dashboard plays it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs curl espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# pytest is a test-only dependency; installed here so `python -m pytest tests/`
# works inside the container without a manual pip install.
RUN pip install --no-cache-dir pytest
